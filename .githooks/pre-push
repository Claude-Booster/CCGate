#!/usr/bin/env bash
# .githooks/pre-push
# Blocks annotated tags whose tagger line or message body contains a restricted
# identifier.  Lightweight tags are skipped — they carry no separate identity
# metadata; the underlying commit was already checked at commit time.
#
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>

set -euo pipefail

# ── Patterns (variable names are intentionally opaque) ─────────────────────────
P1="Fred Mandap|Frederick Mandap|frederick\.mandap|thug_kcirederf"
P2="accenture\.com|Accenture"
_C="$P1|$P2"

FAIL=0

while read -r local_ref _ remote_ref _; do
  [[ "$local_ref" == "(delete)" ]] && continue
  [[ "$remote_ref" != refs/tags/* ]] && continue

  tag_name="${remote_ref#refs/tags/}"

  obj_type=$(git cat-file -t "$local_ref" 2>/dev/null) || continue
  [[ "$obj_type" != "tag" ]] && continue

  tag_content=$(git cat-file tag "$local_ref" 2>/dev/null) || continue

  if printf '%s' "$tag_content" | grep -qiE "$_C"; then
    printf '[pre-push] BLOCKED: annotated tag %q contains a restricted identifier.\n' "$tag_name" >&2
    printf '  Fix: git tag -d %q\n' "$tag_name" >&2
    printf '       (verify a clean identity, then recreate the tag)\n' >&2
    FAIL=1
  fi
done

[[ $FAIL -eq 0 ]] || exit 1
